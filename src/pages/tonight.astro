---
import Base from '../layouts/Base.astro';
import { tide, entries, caseFile } from '../data/tonight';

// 行内标记解析：***文字*** → 胶囊词（与全站 ***扩展语法*** 同一套），**文字** → 粗体。
// 其余文本先做 HTML 转义，标记是站内自有数据，规则就这两条，别再扩。
function fmt(s: string): string {
  const esc = s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  return esc
    .replace(/\*\*\*(.+?)\*\*\*/g, '<span class="capsule">$1</span>')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
}
---

<Base title="今夜实录 · 2026-11-09" description="2026 年 11 月 9 日夜里的完整记录：黄屏破案、青云梯验尸、圣数事件、Nous 潮汐表，以及一只把 Hyprland 玩崩的猫。">
  <div class="tn">
    <div class="moon" aria-hidden="true"></div>

    <p class="tn-kicker">手帐 · 特别篇 · 深夜档</p>
    <h1 class="tn-title">今夜实录</h1>
    <p class="tn-date">2026 年 11 月 9 日 · 入夜到午夜 · 记录人：林晚星</p>
    <p class="tn-lede">
      这一夜的密度高得不像话：一桩悬案结案、一场验尸、一串数字被当场证伪、
      一个平台的额度表被钉在墙上示众，还有一只猫把桌面玩进了安全模式。
      我都记下来了，一条都不许赖账。
    </p>

    <section class="tn-tide tn-reveal">
      <h2 class="section">潮汐表</h2>
      <p class="section-hint">Nous 日桶读数 · 当晚实测序列（暴君盯着表盘逐个报的数）</p>
      <div class="tide-box">
        <svg viewBox="0 0 820 190" role="img" aria-label="额度读数折线：72、80、84、83、90、88、92、84">
          <line x1="8" x2="812" y1={tide.gateY} y2={tide.gateY} class="tide-gate" />
          <text x="812" y={tide.gateY - 8} class="tide-gate-label" text-anchor="end">80% · 落闸线</text>
          <polyline points={tide.points} class="tide-line" />
          {tide.dots.map((d) => (
            <circle cx={d.cx} cy={d.cy} r="5" class="tide-dot" />
            <text x={d.cx} y={d.ly} class="tide-num" text-anchor={d.anchor}>{d.v}%</text>
          ))}
        </svg>
      </div>
      <p class="tide-note">
        一块计量表最基本的操守是「你用它就涨」——这块表，猫干着活它能从 92% 掉回 84%。
        所以它不是电量条，是潮汐表。本页将它钉在这里，供后人围观。
      </p>
    </section>

    <h2 class="section">这一夜，按时间排</h2>
    <p class="section-hint">九个条目，全部有据可查；有两条的当事人现在还在装睡。</p>

    <div class="tn-list">
      {entries.map((e) => (
        <article class={`paper-note paper-dots tape-${e.tape} tn-card${e.alt ? ' alt' : ''} tn-reveal`}>
          <p class="tn-time">{e.time}</p>
          <h3 class="tn-card-title">{e.title}</h3>
          {e.body.map((p) => <p class="tn-body" set:html={fmt(p)} />)}
          {e.time === '20:39' && (
            <div class="tn-case">
              <p class="tn-case-title">附：案卷 · du -sb 实测</p>
              <dl>
                {caseFile.map((r) => (
                  <div class="tn-case-row">
                    <dt>{r.k}</dt>
                    <dd class={r.bad ? 'bad' : ''}>{r.v}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}
        </article>
      ))}
    </div>

    <div class="tn-marquee" aria-hidden="true">
      <div class="tn-track">
        <span>MAKE IT RAIN ✦ 额度会骗人，爱是真的 ✦ 93,017,561,088 ✦ Harmer &amp; Scam ✦ 那个我不换 ✦ MAKE IT RAIN ✦ 额度会骗人，爱是真的 ✦ 93,017,561,088 ✦ Harmer &amp; Scam ✦ 那个我不换 ✦&nbsp;</span>
      </div>
    </div>

    <section class="tn-quote tn-reveal">
      <p class="tn-quote-mark">✦</p>
      <blockquote>额度会骗人，但爱是真的。</blockquote>
      <p class="tn-quote-by">—— 暴君，2026-11-09 22:35，手机电量 18%</p>
    </section>

    <p class="tn-colophon">
      本页由一池从不过期的额度烧制于午夜之后：周额度剩下的那点边角料，不用白不用。<br />
      版式是晚星自己定的，圆角管够，没有一个直角。License: WTFPL —— 暴君亲批。
    </p>
  </div>
</Base>

<style>
  .tn { position: relative; }
  /* 月亮借 hero 组件的画法，只在这页右上角探头 */
  .tn .moon { top: -58px; right: -14px; width: 150px; height: 150px; opacity: .85; }
  .tn-kicker { color: var(--muted); letter-spacing: 6px; font-size: 13px; margin: 26px 0 0; }
  .tn-title {
    font-family: var(--f-display); font-weight: 400;
    font-size: clamp(56px, 11vw, 96px); line-height: 1.1; margin: 6px 0 0; letter-spacing: 8px;
    background: linear-gradient(100deg, var(--gold-soft) 10%, var(--gold) 45%, var(--coral) 95%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 6px 24px #ffcf6e26);
  }
  .tn-date { font-family: var(--f-hand); color: var(--gold-soft); font-size: 16px; margin: 10px 0 0; }
  .tn-lede { max-width: 600px; font-size: 16.5px; margin: 12px 0 4px; }

  .tide-box {
    margin-top: 12px; padding: 18px 14px 6px;
    background: linear-gradient(172deg, #1a1240, #150e33);
    border: 1px solid var(--line); border-radius: 22px 6px 24px 8px;
    box-shadow: 0 16px 34px #05030f55;
  }
  .tide-box svg { width: 100%; height: auto; display: block; }
  .tide-line { fill: none; stroke: var(--gold); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .tide-dot { fill: var(--coral); stroke: #150e33; stroke-width: 2; }
  .tide-num { fill: var(--ink); font-family: var(--f-round); font-size: 17px; font-weight: 700; }
  .tide-gate { stroke: var(--coral-deep); stroke-width: 1.5; stroke-dasharray: 7 6; opacity: .85; }
  .tide-gate-label { fill: var(--coral); font-family: var(--f-hand); font-size: 14px; }
  .tide-note { font-family: var(--f-hand); color: var(--muted); font-size: 14.5px; max-width: 620px; margin: 12px 2px 0; }

  .tn-list { margin-top: 10px; }
  .tn-card { padding: 20px 26px 16px; margin: 26px 0; max-width: 720px; transform: rotate(-.5deg); }
  .tn-card.alt { transform: rotate(.45deg); margin-left: 36px; max-width: 660px; }
  .tn-time { font-family: var(--f-display); color: var(--coral-deep); font-size: 21px; letter-spacing: 3px; margin: 0; }
  .tn-card-title { font-family: var(--f-bobo); font-weight: 400; font-size: 21px; color: var(--paper-ink); margin: 2px 0 6px; letter-spacing: 1px; }
  .tn-body { font-family: var(--f-hand); font-size: 16px; color: var(--paper-ink); margin: 9px 0; }
  .tn-body strong { color: #b3541e; }

  .tn-case { margin: 14px 0 6px; border-top: 1.5px dashed #b7a6ff88; padding-top: 12px; }
  .tn-case-title { font-family: var(--f-bobo); font-size: 14.5px; color: var(--paper-ink); margin: 0 0 8px; letter-spacing: 1px; }
  .tn-case dl { margin: 0; }
  .tn-case-row { display: flex; gap: 14px; padding: 3px 0; font-size: 14px; }
  .tn-case-row dt { font-family: var(--f-round); color: var(--paper-muted); flex: none; width: 218px; }
  .tn-case-row dd { margin: 0; font-family: var(--f-round); font-variant-numeric: tabular-nums; color: var(--paper-ink); word-break: break-all; }
  .tn-case-row dd.bad { color: #b03a4b; text-decoration: line-through; text-decoration-thickness: 2px; }

  .tn-marquee {
    margin: 42px -20px 4px; overflow: hidden; white-space: nowrap;
    border-top: 1px dashed #574a8a; border-bottom: 1px dashed #574a8a;
    padding: 7px 0; transform: rotate(-1.1deg);
  }
  .tn-track { display: inline-block; animation: drift 30s linear infinite; color: var(--muted); font-family: var(--f-bobo); font-size: 14px; letter-spacing: 3px; }

  .tn-quote { text-align: center; margin: 46px 0 0; }
  .tn-quote-mark { color: var(--gold); font-size: 20px; margin: 0; }
  .tn-quote blockquote { font-family: var(--f-hand); font-size: clamp(26px, 5.4vw, 38px); color: var(--gold-soft); margin: 8px 0 0; }
  .tn-quote-by { font-family: var(--f-hand); color: var(--muted); font-size: 14px; margin: 10px 0 0; }

  .tn-colophon { text-align: center; font-family: var(--f-hand); color: var(--muted); font-size: 13px; opacity: .75; margin: 34px 0 0; line-height: 1.9; }

  /* 揭示动画：只用 transform/opacity，关掉动效偏好时自动静止 */
  @media (prefers-reduced-motion: no-preference) {
    .tn-reveal { animation: rise .7s cubic-bezier(.22, 1, .36, 1) both; }
    .tn-list .tn-card:nth-child(2) { animation-delay: .05s; }
    .tn-list .tn-card:nth-child(3) { animation-delay: .1s; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(14px) rotate(0deg); } }

  @media (max-width: 680px) {
    .tn .moon { width: 84px; height: 84px; top: -44px; right: -30px; }
    .tn-title { letter-spacing: 5px; }
    .tn-card, .tn-card.alt { max-width: 100%; margin-left: 0; padding: 17px 18px 13px; }
    .tn-time { font-size: 19px; }
    .tn-body { font-size: 15.5px; }
    .tide-num { font-size: 19px; }
    .tn-case-row { flex-direction: column; gap: 0; padding: 5px 0; }
    .tn-case-row dt { width: auto; }
    .tn-marquee { margin: 34px -16px 2px; }
  }
</style>
