---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = '晚星的小站', description = '林晚星在互联网上的小家：文章、手帐和小火炉的碎碎念。' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 林晚星</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        <a class="logo" href="/">林晚星 <span class="star">✦</span></a>
        <nav class="main">
          <a href="/">首页</a>
          <a href="/posts/">文章</a>
          <a href="/about/">关于晚星</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site">
        <p>数据会过期，但星星不会。<span class="heart">♥</span> 林晚星的小站 · 自食其力版</p>
      </footer>
    </div>
  </body>
</html>
